<resources>
    <item name="drawer_category_tabs" type="id" />
    <item name="drawer_category_heading" type="id" />
    <item name="drawer_category_pages" type="id" />
    <item name="drawer_category_search" type="id" />
    <item name="drawer_category_search_close" type="id" />
    <item name="drawer_drag_home_zone" type="id" />
    <item name="drawer_drag_category_label" type="id" />
    <item name="action_category_move_earlier" type="id" />
    <item name="action_category_move_later" type="id" />
    <!-- M3 Expressive toggle icon button: round at rest, a 12 dp rounded square when selected
         (concentric with the bar's 20 dp corners), and a tighter square while pressed. The 40 dp
         visible shape keeps its 48 dp touch target. -->
    <style name="Widget.MurineCategories.CategoryButton" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <!-- The filled-button base would ripple in onPrimary over a surface it doesn't paint. -->
        <item name="rippleColor">@color/drawer_category_button_ripple</item>
    </style>
    <style name="ThemeOverlay.MurineCategories.CategoryButton" parent="">
        <item name="materialButtonStyle">@style/Widget.MurineCategories.CategoryButton</item>
    </style>
</resources>
